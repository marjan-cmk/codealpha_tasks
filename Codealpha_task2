# Feature extraction function
def extract_mfcc(file_path, max_pad_len=100):
    try:
        audio, sr = librosa.load(file_path, duration=3, sr=16000)
        mfcc = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=40)
        
        # Pad or truncate to fixed length
        if mfcc.shape[1] < max_pad_len:
            pad_width = max_pad_len - mfcc.shape[1]
            mfcc = np.pad(mfcc, pad_width=((0, 0), (0, pad_width)), mode='constant')
        else:
            mfcc = mfcc[:, :max_pad_len]
        
        return mfcc
    except Exception as e:
        print(f"Error processing {file_path}: {e}")
        return None

# Sample synthetic dataset (replace with real RAVDESS/TESS
emotions = ['happy', 'angry', 'sad', 'neutral', 'fearful', 'surprised']
emotion_map = {'01': 'neutral', '02': 'neutral', '03': 'happy', '04': 'sad', 
               '05': 'angry', '06': 'fearful', '07': 'surprised'}

def load_ravdess_data(path_to_ravdess_folder):
    X, y = [], []
    for file in os.listdir(path_to_ravdess_folder):
        if file.endswith('.wav'):
            emotion_code = file.split('-')[2]
            emotion = emotion_map.get(emotion_code, 'unknown')
            if emotion != 'unknown':
                mfcc = extract_mfcc(os.path.join(path_to_ravdess_folder, file))
                if mfcc is not None:
                    X.append(mfcc)
                    y.append(emotion)
    return np.array(X), np.array(y)

