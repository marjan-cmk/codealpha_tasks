# 2. Control Flow & Loops
print("--- Number Classifier Loop ---")
# Using a loop and conditional statements to check numbers from 1 to 5
for number in range(1, 6):
    if number % 2 == 0:
        print(f"{number} is Even")
    else:
        print(f"{number} is Odd")
print()


# 3. Lists and Custom Functions
print("--- List Processing Function ---")

# Define a sample list of scores
test_scores = [78, 85, 92, 64, 90, 88]

def analyze_scores(scores_list):
    """
    Takes a list of numeric scores and returns the 
    highest score, lowest score, and the average score.
    """
    highest = max(scores_list)
    lowest = min(scores_list)
    average = sum(scores_list) / len(scores_list)
    
    return highest, lowest, round(average, 2)

# Call the function and unpack results
high, low, avg = analyze_scores(test_scores)

print(f"Scores Analyzed: {test_scores}")
print(f"Highest Score: {high}")
print(f"Lowest Score:  {low}")
print(f"Average Score: {avg}")
